node_modules/
.vitest-cache/
.DS_Store
*.log

# Ship the built MCP server with the repo — Claude Code's marketplace install
# pulls source but doesn't run pnpm build, so the bundled artifact has to live
# in git. Other dist/ directories stay ignored. Sourcemaps stay ignored too —
# only the executable bundle needs to be shipped.
dist/
!mcp/server/dist/
!mcp/server/dist/index.js

# Personal session memory (not part of the project artifact)
.remember/

# Per-project ACC state (created by the MCP server when this repo is itself
# used as a projectRoot during local testing).
.acc/

# Build / coverage artifacts
coverage/
