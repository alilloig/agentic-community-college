<!doctype html>
<!--
  ACC lesson summary template (skills/chapter-artifact/templates/summary.html.tmpl).
  Conductor: fill every {{ placeholder }}, keep the section order, delete these
  comments. Rules: ../references/conventions.md. Self-contained: no <script src>,
  no <link href>, no @import, no web fonts, no images loaded from a URL.
-->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ lesson_title }} · Summary</title>
<style>
  :root {
    --bg:#0e1117; --panel:#161b22; --panel-2:#1f242d; --border:#2a313c;
    --fg:#d5d9e0; --muted:#8b94a7; --accent:#79b8ff; --good:#6dd56d;
    --warn:#e6c07b; --bad:#e08585; --code-bg:#0b0e13;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px; line-height: 1.55; }
  body { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  header { margin-bottom: 1.5rem; }
  .eyebrow { color: var(--muted); font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; margin: 0 0 .4rem; }
  h1 { font-size: 1.7rem; margin: 0 0 .5rem; letter-spacing: -.01em; }
  h2 { font-size: 1.15rem; margin: 0 0 .7rem; padding-bottom: .3rem; border-bottom: 1px solid var(--border); }
  h3 { font-size: 1rem; margin: .2rem 0 .3rem; }
  p { margin: 0 0 .8rem; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: .92em; background: var(--code-bg); padding: 1px 5px; border-radius: 3px; }
  .meta { color: var(--muted); font-size: .9rem; }
  .status { display: inline-block; padding: 1px 9px; border-radius: 999px; font-weight: 600; font-size: .8rem; border: 1px solid currentColor; }
  .status.good { color: var(--good); }
  .status.warn { color: var(--warn); }
  .status.bad { color: var(--bad); }
  section { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 1.1rem 1.4rem 1.3rem; margin: 1rem 0; }
  figure { margin: 0; }
  figcaption { color: var(--muted); font-size: .85rem; margin: .4rem 0 0; }
  svg { max-width: 100%; height: auto; display: block; }
  .box { fill: var(--panel-2); stroke: var(--border); stroke-width: 1.2; }
  .box.hi { stroke: var(--accent); stroke-width: 1.6; }
  .lbl { fill: var(--fg); font-size: 13px; font-weight: 600; }
  .sub { fill: var(--muted); font-size: 11px; }
  .arrow { stroke: var(--muted); stroke-width: 1.4; fill: none; marker-end: url(#arrow); }
  .edge { fill: var(--muted); font-size: 11px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .8rem; }
  a.card { display: block; background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; padding: .9rem 1rem; color: var(--fg); }
  a.card:hover { border-color: var(--accent); text-decoration: none; }
  a.card .n { color: var(--accent); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
  a.card p { color: var(--muted); font-size: .9rem; margin: 0; }
  ul { margin: 0; padding-left: 1.2rem; }
  li { margin: .35rem 0; }
  footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .9rem; }
  @media (max-width: 720px) {
    body { padding: 1.2rem 1rem 3rem; }
    h1 { font-size: 1.4rem; }
    section { padding: .9rem 1rem 1rem; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<header>
  <p class="eyebrow">{{ lesson_title }} · Summary</p>
  <h1>{{ lesson_title }}</h1>
  <!-- e2e_class: good (passed) | warn (skipped for credentials) | bad (failed).
       e2e_status text: "e2e passed" | "e2e skipped: <VAR> not set" | "e2e failed". -->
  <p class="meta">Completed {{ completed_date }} · <span class="status {{ e2e_class }}">{{ e2e_status }}</span></p>
</header>

<section id="built">
  <h2>What you built</h2>
  <!-- One paragraph, then the final architecture: every chapter's contribution in one picture. Max 10 boxes. -->
  <p>{{ what_you_built }}</p>
  <figure>
    <svg viewBox="0 0 800 260" role="img" aria-label="{{ diagram_label }}">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#8b94a7"/>
        </marker>
      </defs>
      <rect class="box" x="40" y="100" width="200" height="60" rx="8"/>
      <text class="lbl" x="140" y="126" text-anchor="middle">{{ box_1 }}</text>
      <text class="sub" x="140" y="144" text-anchor="middle">{{ box_1_sub }}</text>
      <path class="arrow" d="M240,130 L300,130"/>
      <text class="edge" x="270" y="120" text-anchor="middle">{{ edge_1 }}</text>
      <rect class="box hi" x="300" y="100" width="200" height="60" rx="8"/>
      <text class="lbl" x="400" y="126" text-anchor="middle">{{ box_2 }}</text>
      <text class="sub" x="400" y="144" text-anchor="middle">{{ box_2_sub }}</text>
      <path class="arrow" d="M500,130 L560,130"/>
      <text class="edge" x="530" y="120" text-anchor="middle">{{ edge_2 }}</text>
      <rect class="box" x="560" y="100" width="200" height="60" rx="8"/>
      <text class="lbl" x="660" y="126" text-anchor="middle">{{ box_3 }}</text>
      <text class="sub" x="660" y="144" text-anchor="middle">{{ box_3_sub }}</text>
    </svg>
    <figcaption>{{ diagram_caption }}</figcaption>
  </figure>
</section>

<section id="chapters">
  <h2>Chapters</h2>
  <!-- One card per chapter, in order. href is the relative artifact filename NN-<id>.html. -->
  <div class="cards">
    <a class="card" href="{{ chapter_1_file }}">
      <span class="n">Chapter 1</span>
      <h3>{{ chapter_1_title }}</h3>
      <p>{{ chapter_1_key_idea }}</p>
    </a>
    <a class="card" href="{{ chapter_2_file }}">
      <span class="n">Chapter 2</span>
      <h3>{{ chapter_2_title }}</h3>
      <p>{{ chapter_2_key_idea }}</p>
    </a>
  </div>
</section>

<section id="learnings">
  <h2>Most important learnings</h2>
  <!-- 5 to 8 bullets. Each one a concrete takeaway the learner can restate. -->
  <ul>
    <li>{{ learning_1 }}</li>
    <li>{{ learning_2 }}</li>
    <li>{{ learning_3 }}</li>
    <li>{{ learning_4 }}</li>
    <li>{{ learning_5 }}</li>
  </ul>
</section>

<section id="next">
  <h2>Where to go next</h2>
  <!-- 3 to 5 pointers: docs sections not covered, features to add, ideas to extend the app.
       Plain <a href> text links to external docs are allowed here. -->
  <ul>
    <li>{{ next_1 }}</li>
    <li>{{ next_2 }}</li>
    <li>{{ next_3 }}</li>
  </ul>
</section>

<footer>
  Generated by the ACC course-conductor · artifacts live next to this file in <code>artifacts/</code>
</footer>

</body>
</html>
